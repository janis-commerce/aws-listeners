{
  "exclude": [
    "coverage/",
    "tests/",
    "mocks/",
    ".eslintrc.js",
    ".travis.yml"
  ],
  "extension": [
    ".js"
  ],
  "cache": true,
  "all": true,
  "default-excludes": true,
  "skip-full": true,
  "check-coverage": true,
  "statements": 100,
  "branches": 100,
  "functions": 100,
  "lines": 100
}
